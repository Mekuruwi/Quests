{
  "name": "quests-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "prestart": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.electron.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "electron:build": "npm run build && electron-builder --publish never",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "knex": "^3.3.0",
    "lucide-react": "^1.55.0",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^29.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.4"
  },
  "build": {
    "appId": "com.quests.app",
    "productName": "Questly",
    "files": [
      "dist/**/*",
      "dist-electron/main.js",
      "electron/preload.cjs",
      "package.json"
    ],
    "win": {
      "artifactName": "Questly-Setup-${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "Mekuruwi",
      "repo": "Quests",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist-electron/installer"
    }
  }
}
